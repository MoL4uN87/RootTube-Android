<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Настраивай звук во время просмотра. Положение ползунков запоминается."
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp"
        android:paddingBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Оригинальная речь"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/votOriginalValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25%"
            android:contentDescription="Громкость оригинала"
            android:textSize="14sp" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/votOriginalSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="Регулировать оригинальную дорожку"
        app:valueFrom="0"
        app:valueTo="100"
        app:stepSize="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Русская AI-озвучка"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/votTranslatedValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:contentDescription="Громкость перевода"
            android:textSize="14sp" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/votTranslatedSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="Регулировать русскую озвучку"
        app:valueFrom="0"
        app:valueTo="100"
        app:stepSize="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Если перевести оригинал на 0%, будет слышна только русская речь. Без AI-перевода громкость видео не меняется."
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp"
        android:paddingTop="20dp" />

</LinearLayout>
